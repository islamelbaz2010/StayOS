*.xlsx
*.pptx
*.apk
/screen_*.png
/window_dump*.xml
/apps/web/
/src/
/tests/
/alembic/
/scripts/
/infra/
node_modules/
.expo/
.next/
/apps/web/node_modules/
/apps/web/.next/
