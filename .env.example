# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/stayos

# Redis
REDIS_URL=redis://localhost:6379/0

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
WEB_BASE_URL=http://localhost:3000

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Twilio (general SMS notifications only — OTP auth uses Akedly, below)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Akedly (OTP auth — send/verify). V1.2 pipeline "StayOS" — PoW + Turnstile enabled.
# AKEDLY_API_KEY: real secret — obtain from the Akedly dashboard, never commit it.
# AKEDLY_PIPELINE_ID is not a secret (it's a public pipeline identifier); the real
# StayOS pipeline ID is filled in below.
AKEDLY_API_KEY=
AKEDLY_PIPELINE_ID=6a8f50e0d9d85332c73b7606
AKEDLY_BASE_URL=https://api.akedly.io/api/v1.2

# Paymob
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_NOTIFICATION_URL=

# WhatsApp / Meta
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=

# AWS S3
S3_LISTINGS_BUCKET=
S3_KYC_BUCKET=
S3_PAYMENT_PROOF_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for S3-compatible providers; leave blank for AWS S3.
S3_ENDPOINT_URL=
S3_PRESIGNED_GET_TTL_SECONDS=86400

# Sentry
SENTRY_DSN=

# OTP Configuration
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_WINDOW=900

# JWT (RS256) - paste PEM strings or use file-based loading in production
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Manual payment collection (P0-1: real values required before live transactions)
PAYMENT_BANK_NAME_AR=
PAYMENT_BANK_NAME_EN=
PAYMENT_ACCOUNT_NAME=
PAYMENT_BANK_ACCOUNT_NUMBER=
PAYMENT_VODAFONE_CASH_NUMBER=

# Calendar Lock
CALENDAR_LOCK_TIMEOUT_MS=5000

# Image host allowlist (comma-separated suffixes)
IMAGE_HOST_ALLOWLIST=.amazonaws.com,images.unsplash.com

# Business defaults
# Canonical commercial model (FD-19): 12% total StayOS economics on the
# accommodation amount, internally allocated 6% host-side + 6% guest-side.
# The guest-facing price is all-inclusive — this is never added on top and
# never shown to the guest as a fee.
PLATFORM_TOTAL_SHARE_PCT=0.12
HOST_SIDE_SHARE_PCT=0.06
GUEST_SIDE_SHARE_PCT=0.06
# StayOS configured VAT rate — a separate tax on the taxable booking
# amount (accommodation + cleaning after discounts), added to the guest
# total. Independent of the 12% platform share; not StayOS revenue and
# not host earnings.
VAT_RATE_PCT=0.14
CANCELLATION_FULL_REFUND_DAYS=7
CANCELLATION_PARTIAL_REFUND_DAYS=3
CANCELLATION_PARTIAL_REFUND_PCT=0.5
