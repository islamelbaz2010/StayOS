# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/stayos

# Redis
REDIS_URL=redis://localhost:6379/0

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Paymob
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=

# WhatsApp / Meta
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=

# AWS S3
S3_LISTINGS_BUCKET=
S3_KYC_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Sentry
SENTRY_DSN=

# OTP Configuration
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_WINDOW=900

# JWT (RS256) - paste PEM strings or use file-based loading in production
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Calendar Lock
CALENDAR_LOCK_TIMEOUT_MS=5000

# Image host allowlist (comma-separated suffixes)
IMAGE_HOST_ALLOWLIST=.amazonaws.com

# Business defaults
GUEST_SERVICE_FEE_PCT=0.04
HOST_COMMISSION_PCT=0.10
PLATFORM_TAKE_RATE_PCT=0.02
CANCELLATION_FULL_REFUND_DAYS=7
CANCELLATION_PARTIAL_REFUND_DAYS=3
CANCELLATION_PARTIAL_REFUND_PCT=0.5
