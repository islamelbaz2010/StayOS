# Staging environment template for docker-compose.staging.yml
# Copy to .env.staging and replace all placeholder values with real credentials
# before running the staging deployment scripts.

# Application
ENVIRONMENT=staging
LOG_LEVEL=INFO

# Database (PostGIS is provided by the postgres service)
DATABASE_URL=postgresql+asyncpg://stayos:stayos@postgres:5432/stayos

# Redis (Celery broker and backend use separate logical DBs automatically)
REDIS_URL=redis://redis:6379/0

# CORS origins for the staging web and admin frontends
CORS_ORIGINS=https://app-staging.stayos.com,https://admin-staging.stayos.com

# JWT RS256 keys - replace with real PEM values or use a secrets manager
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Firebase Admin SDK
FIREBASE_PROJECT_ID=stayos-staging
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@stayos-staging.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Twilio (general SMS notifications only — OTP auth uses Akedly, below)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Akedly (OTP auth — send/verify). V1.2 pipeline "StayOS" — PoW + Turnstile enabled.
# AKEDLY_API_KEY is a real secret — obtain from the Akedly dashboard, never commit it.
AKEDLY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AKEDLY_PIPELINE_ID=6a8f50e0d9d85332c73b7606
AKEDLY_BASE_URL=https://api.akedly.io/api/v1.2

# Paymob (required for EGP payments)
PAYMOB_API_KEY=xxxxxxxxxxxxxxxx
PAYMOB_HMAC_SECRET=xxxxxxxxxxxxxxxx
PAYMOB_INTEGRATION_ID=12345
PAYMOB_IFRAME_ID=12345

# Stripe (required for USD/card payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Meta WhatsApp
META_WHATSAPP_TOKEN=EAAG...
META_PHONE_NUMBER_ID=123456789012345

# AWS S3
S3_LISTINGS_BUCKET=stayos-staging-listings
S3_KYC_BUCKET=stayos-staging-kyc
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# Sentry
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# OTP / Rate limiting
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_WINDOW=900

# Calendar Lock
CALENDAR_LOCK_TIMEOUT_MS=5000

# Business defaults
GUEST_SERVICE_FEE_PCT=0.04
HOST_COMMISSION_PCT=0.10
PLATFORM_TAKE_RATE_PCT=0.02
CANCELLATION_FULL_REFUND_DAYS=7
CANCELLATION_PARTIAL_REFUND_DAYS=3
CANCELLATION_PARTIAL_REFUND_PCT=0.5

# Image host allowlist
IMAGE_HOST_ALLOWLIST=.amazonaws.com
