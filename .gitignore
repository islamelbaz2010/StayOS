# StayOS .gitignore

# Build artifacts
/target/
/build/
/dist/
/bin/
/lib/
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# Rust
Cargo.lock
**/*.rs.bk
.cargo/

# C++
*.o
*.obj
*.so
*.dylib
*.dll
*.exe
*.out
*.app
*.i86
*.x86_64
*.hex

# OS-specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# AI assistant scratch workspaces
.akwb/
.claude/
.devin/mcp_config.local.json

# Logs
*.log
logs/
/.ai/LOGS/
*.log.*

# Testing
.coverage
coverage/
*.cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.nyc_output/

# Documentation
/docs/_build/
/docs/.doctrees/
/site/

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# Environment
.env
.env.local
.env.*.local
.env.staging
*.env

# Celery beat schedule
celerybeat-schedule*

# Secrets
*.key
*.pem
*.crt
secrets/
*.secret

# Database
*.db
*.sqlite
*.sqlite3

# Package files
*.tar.gz
*.zip
*.rar
*.7z

# Node modules (if using any node tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (if using any python tools)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/

# Do not ignore the Next.js app library
!apps/web/lib/
!apps/web/lib/**
!apps/mobile/src/lib/
!apps/mobile/src/lib/**
*.egg-info/
.installed.cfg
*.egg

# Kernel specific
kernel.img
kernel.bin
*.iso
*.img

# Bootloader
bootloader/
boot/

# User space
userspace/

# Drivers
drivers/*.ko
drivers/*.o

# Documentation builds
docs/build/
docs/output/

# CI/CD
.github/workflows/*.log

# Backup files
*.orig
*.rej

# Generated files
generated/
auto/
apps/web/lib/openapi.json
.next/
*.tsbuildinfo
htmlcov/

# Bootstrap system — generated reports (never commit)
BOOTSTRAP_REPORT.md
/DOCTOR_REPORT.md

# Expo / mobile build artifacts
apps/mobile/.expo/
apps/mobile/*.apk
apps/mobile/*.apk.zip
apps/mobile/*.ipa
apps/mobile/android/
apps/mobile/ios/

# Playwright / E2E artifacts
apps/web/test-results/
apps/web/playwright-report/
booking_e2e_*/

# Generated OpenAPI schema at root (canonical copy is ignored above)
/openapi.json

# Evidence and build artifacts
evidence/
*.apk
*.ipa
