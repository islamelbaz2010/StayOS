{
  "expo": {
    "name": "MAKAZOH",
    "slug": "stayos-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "stayos",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F7FEE7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stayos.mobile"
    },
    "android": {
      "package": "com.stayos.mobile"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "MAKAZOH needs access to your photos to upload payment receipts and identity documents.",
          "cameraPermission": "MAKAZOH needs camera access to photograph your identity document and take a verification selfie."
        }
      ],
      "expo-document-picker",
      "expo-notifications",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "04b13a13-9ae5-4bdb-8211-a2b862116bbc"
      }
    },
    "owner": "islamelbaz"
  }
}
