# StayOS Web — Frontend environment variables
# Copy this file to .env.local and fill in real values.

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Comma-separated list of remote image host patterns for next/image.
# Falls back to "**.amazonaws.com" if unset. Example:
# NEXT_PUBLIC_IMAGE_HOSTS=cdn.stayos.example.com,images.stayos.example.com
NEXT_PUBLIC_IMAGE_HOSTS=

# Firebase web app configuration (used for phone OTP)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
